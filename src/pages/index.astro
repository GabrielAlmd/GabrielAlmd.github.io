---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredProjects = (await getCollection(
  'projects',
  ({ data }) => data.featured && !data.draft,
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner container">
      <p class="eyebrow">Embedded Software Engineer / Maker</p>
      <h1 id="hero-title">Gabriel Almeida</h1>
      <p class="brand-statement">Build. Solve. Share.</p>
      <p class="hero-summary">
        Things I build, problems I solve, and what I learn along the way—across
        embedded software, systems, electronics, and practical engineering tools.
      </p>
      <div class="hero-actions" aria-label="Primary links">
        <a class="button button--primary" href="/projects/">Explore projects</a>
        <a class="button button--secondary" href="https://github.com/GabrielAlmd" rel="me">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="process-line" aria-label="Working process">
        <span>Idea</span><span aria-hidden="true">→</span><span>Iteration</span><span aria-hidden="true">→</span><span>Result</span>
      </p>
    </div>
  </section>

  <section class="section section--projects" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / Projects</p>
          <h2 id="featured-heading">Featured projects</h2>
        </div>
        <a href="/projects/">View all projects</a>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="interests-heading">
    <div class="container">
      <p class="eyebrow">02 / Areas of work</p>
      <h2 id="interests-heading">Engineering interests</h2>
      <div class="interest-grid">
        <article>
          <h3>Embedded systems</h3>
          <p>Embedded Linux, C/C++, electronics, and systems programming.</p>
        </article>
        <article>
          <h3>Reliability</h3>
          <p>Debugging, observability, networking, and careful fault analysis.</p>
        </article>
        <article>
          <h3>Engineering tools</h3>
          <p>Automation, repeatable workflows, prototyping, and 3D printing.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">03 / Open knowledge</p>
        <h2 id="contact-heading">Follow the work</h2>
      </div>
      <div>
        <p>
          The goal is practical documentation: work that can be understood, reused,
          challenged, and improved.
        </p>
        <ul class="link-list">
          <li><a href="https://github.com/GabrielAlmd" rel="me">GitHub</a></li>
          <li><a href="/about/">About this space</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
