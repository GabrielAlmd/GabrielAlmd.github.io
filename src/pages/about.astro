---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About Gabriel Almeida's engineering background, approach, technologies, and interests."
>
  <header class="page-intro container">
    <p class="eyebrow">03 / About</p>
    <h1>Engineering with context and constraints in mind</h1>
    <p>
      I am an embedded software engineer interested in dependable systems,
      practical debugging, and tools that make engineering work more repeatable.
    </p>
  </header>

  <section class="section">
    <div class="container split-grid">
      <div>
        <p class="section-index">01</p>
        <h2>Professional background</h2>
      </div>
      <p>
        This section will provide a concise overview of relevant embedded software
        and systems experience without duplicating a full CV.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div>
        <p class="section-index">02</p>
        <h2>Engineering approach</h2>
      </div>
      <p>
        Start from the system constraints, make behavior observable, reduce
        uncertainty through testing, and leave the implementation easier to operate
        and extend.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div>
        <p class="section-index">03</p>
        <h2>Technologies</h2>
      </div>
      <ul class="tag-list" aria-label="Technologies">
        <li>C</li>
        <li>C++</li>
        <li>Embedded Linux</li>
        <li>Networking</li>
        <li>Automation</li>
        <li>Engineering tooling</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div>
        <p class="section-index">04</p>
        <h2>Personal engineering interests</h2>
      </div>
      <p>
        Electronics, small-scale fabrication, 3D printing, and projects that connect
        physical systems with well-designed software.
      </p>
    </div>
  </section>
</BaseLayout>
