---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header">
  <nav class="site-nav container" aria-label="Primary navigation">
    <a class="site-name" href="/">Gabriel Almeida</a>

    <ul class="nav-links">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="https://github.com/GabrielAlmd" rel="me">GitHub</a>
      </li>
    </ul>
  </nav>
</header>
