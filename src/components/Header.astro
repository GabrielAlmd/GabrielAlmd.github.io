---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/challenges/', label: 'Challenges' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header">
  <nav class="site-nav container" aria-label="Primary navigation">
    <a class="site-brand" href="/" aria-label="Gabriel Almeida, home">
      <span class="site-name">Gabriel Almeida</span>
      <span class="site-discipline">Engineering / Making</span>
    </a>

    <ul class="nav-links">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="external-link" href="https://github.com/GabrielAlmd" rel="me">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </nav>
</header>
